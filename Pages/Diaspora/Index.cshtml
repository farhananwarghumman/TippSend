    </div>
</section>

@section Scripts {
<script>
(function() {
    var offsets = { gb: -1, us: -5, au: 10, ae: 3 };
    var el = document.getElementById('istTime');

    function update() {
        var parts = el.value.split(':');
        var h = parseInt(parts[0]), m = parseInt(parts[1]);
        document.getElementById('ist-display').textContent = fmt(h, m);
        document.getElementById('gb-display').textContent = fmtOff(h, m, offsets.gb);
        document.getElementById('us-display').textContent = fmtOff(h, m, offsets.us);
        document.getElementById('au-display').textContent = fmtOff(h, m, offsets.au);
        document.getElementById('ae-display').textContent = fmtOff(h, m, offsets.ae);
    }

    function fmt(h, m) { return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0'); }

    function fmtOff(h, m, off) {
        var nh = h + off;
        var day = '';
        if (nh < 0) { nh += 24; day = ' -1 day'; }
        if (nh >= 24) { nh -= 24; day = ' +1 day'; }
        return fmt(nh, m) + day;
    }

    el.addEventListener('input', update);
    update();
})();
</script>
}
