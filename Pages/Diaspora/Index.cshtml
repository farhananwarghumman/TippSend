@page
@model IndexModel
@{
    ViewData["Title"] = "Send a gift from abroad";
}

<!-- HERO -->
<section class="diaspora-hero">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1 style="color:var(--gs-cream)">You're in London.<br>She's in Clonmel.<br>We're around the corner.</h1>
                <p class="lead mb-4" style="color:var(--gs-fog)">Send something specific from a real local shop — flowers from the florist she always loved, a cake from the bakery downtown — at the exact moment you want it to arrive.</p>
                <a asp-page="/Book/Step1" class="btn btn-gold btn-lg px-5">Send a gift from abroad</a>
            </div>
            <div class="col-lg-5 offset-lg-1">
                <!-- Time zone converter -->
                <div class="tz-converter">
                    <div class="fw-semibold mb-3" style="color:var(--gs-gold)">Time zone helper</div>
                    <p class="small mb-3" style="color:var(--gs-fog)">Enter the IST time you want delivery — see your local equivalent.</p>
                    <div class="mb-3">
                        <label class="form-label small" style="color:var(--gs-fog)">Irish delivery time (IST)</label>
                        <input type="time" id="istTime" class="form-control" value="19:00" style="max-width:160px;background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);color:white" />
                    </div>
                    <div id="tzRows">
                        <div class="tz-row">
                            <span>🇮🇪 Ireland (IST)</span>
                            <span class="fw-bold" id="ist-display">19:00</span>
                        </div>
                        <div class="tz-row">
                            <span>🇬🇧 London (GMT/BST)</span>
                            <span class="fw-bold" id="gb-display">18:00</span>
                        </div>
                        <div class="tz-row">
                            <span>🇺🇸 New York (EDT/EST)</span>
                            <span class="fw-bold" id="us-display">14:00</span>
                        </div>
                        <div class="tz-row">
                            <span>🇦🇺 Sydney (AEST/AEDT)</span>
                            <span class="fw-bold" id="au-display">05:00 +1</span>
                        </div>
                        <div class="tz-row">
                            <span>🇦🇪 Dubai (GST)</span>
                            <span class="fw-bold" id="ae-display">22:00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

