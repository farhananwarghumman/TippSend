<div class="gift-layout">

    <!-- ── Left sidebar ── -->
    <aside class="gift-sidebar">
        <div class="gift-sidebar__eyebrow" data-anim>Gift & Deliver</div>
        <h2 class="gift-sidebar__heading" data-anim style="--anim-delay:0.06s">
            Curated Local Gifts<br>from <em>South Tipperary</em>
        </h2>
        <p class="gift-sidebar__sub" data-anim style="--anim-delay:0.1s">
            Real gifts from real Tipperary shops — sourced fresh the morning of delivery, with a handwritten card included.
        </p>

        <div class="gift-sidebar__section-label">Browse by category</div>
        <button class="gift-cat-link active" data-cat="all" data-anim style="--anim-delay:0.12s;background:none;border:none;text-align:left;width:100%;cursor:pointer">
            <span class="gift-cat-link__icon">✨</span>
            All Gifts
            <span class="gift-cat-link__count">22</span>
        </button>
        <button class="gift-cat-link" data-cat="Flowers" data-anim style="--anim-delay:0.14s;background:none;border:none;text-align:left;width:100%;cursor:pointer">
            <span class="gift-cat-link__icon">🌹</span>
            Flowers
            <span class="gift-cat-link__count">4</span>
        </button>
        <button class="gift-cat-link" data-cat="Food &amp; Drink" data-anim style="--anim-delay:0.16s;background:none;border:none;text-align:left;width:100%;cursor:pointer">
            <span class="gift-cat-link__icon">🍞</span>
            Food &amp; Drink
            <span class="gift-cat-link__count">6</span>
        </button>
        <button class="gift-cat-link" data-cat="Gifts" data-anim style="--anim-delay:0.18s;background:none;border:none;text-align:left;width:100%;cursor:pointer">
            <span class="gift-cat-link__icon">🎁</span>
            Gifts
            <span class="gift-cat-link__count">8</span>
        </button>
        <button class="gift-cat-link" data-cat="Hampers" data-anim style="--anim-delay:0.2s;background:none;border:none;text-align:left;width:100%;cursor:pointer">
            <span class="gift-cat-link__icon">🧺</span>
            Hampers
            <span class="gift-cat-link__count">4</span>
        </button>

        <div class="gift-sidebar__cta" data-anim style="--anim-delay:0.22s">
            <div class="gift-sidebar__info-item d-none d-lg-flex">
                <span>📸</span>
                <p>Doorstep photo sent to you the moment it arrives</p>
            </div>
            <div class="gift-sidebar__info-item d-none d-lg-flex">
                <span>✉️</span>
                <p>Handwritten card included with every order</p>
            </div>
            <div class="gift-sidebar__info-item d-none d-lg-flex">
                <span>⏱</span>
                <p>Exact Moment delivery — within 5 minutes of your chosen time</p>
            </div>
            <!-- Schedule date picker -->
            <div class="d-none d-lg-block mt-3 mb-2">
                <label style="font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gs-gold-soft);display:block;margin-bottom:6px">
                    Delivery date
                </label>
                <input type="date" id="giftDate"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm"
                       style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:var(--gs-cream);font-size:13px" />
            </div>
            <a id="giftBookBtn" href="/Book/Step1?preselectedDate=@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
               class="btn btn-gold w-100 mt-1 d-none d-lg-flex" style="justify-content:center">
                Send a gift →
            </a>
            <a href="https://wa.me/353899258702?text=Hi%2C%20I%27d%20like%20to%20order%20a%20gift%20delivery." target="_blank" rel="noopener"
               class="d-none d-lg-flex w-100 mt-2 align-items-center justify-content-center gap-2"
               style="background:#25D366;color:#fff;font-size:13px;font-weight:600;border-radius:var(--r-sm);padding:10px 16px;text-decoration:none">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.570-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                Order via WhatsApp
            </a>
        </div>
    </aside>

    <!-- ── Main product area ── -->
    <main class="gift-main">
        <div class="gift-main-header" data-anim>
            <div>
                <div class="eyebrow mb-1">Our collection</div>
                <h1>Local gifts, delivered today</h1>
            </div>
            <div style="font-size:13px;color:var(--gs-stone)">
                <span id="productCount" style="font-family:var(--mono);font-weight:600;color:var(--gs-bog-deep)">22</span> products · South Tipperary
            </div>
        </div>

        <!-- Category filter tabs -->
        <div class="gift-filters" data-anim style="--anim-delay:0.06s">
            <button class="filter-tab active" data-cat="all">All</button>
            <button class="filter-tab" data-cat="Flowers">🌹 Flowers</button>
            <button class="filter-tab" data-cat="Food &amp; Drink">🍞 Food &amp; Drink</button>
            <button class="filter-tab" data-cat="Gifts">🎁 Gifts</button>
            <button class="filter-tab" data-cat="Hampers">🧺 Hampers</button>
        </div>

        <!-- Occasion filter tabs -->
        <div class="gift-filters" data-anim style="--anim-delay:0.09s;margin-bottom:24px;align-items:center">
            <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--gs-stone);white-space:nowrap">Occasion:</span>
            <button class="filter-tab active" data-occasion="all">All</button>
            <button class="filter-tab" data-occasion="Birthday">🎂 Birthday</button>
            <button class="filter-tab" data-occasion="New Baby">👶 New Baby</button>
            <button class="filter-tab" data-occasion="Sympathy">🤍 Sympathy</button>
            <button class="filter-tab" data-occasion="Anniversary">💑 Anniversary</button>
            <button class="filter-tab" data-occasion="Thank You">🌻 Thank You</button>
            <button class="filter-tab" data-occasion="Congratulations">🥂 Congratulations</button>
        </div>

        <!-- Product grid -->
        <div class="product-grid" data-anim style="--anim-delay:0.1s">
            @foreach (var p in products)
            {
                <div class="product-card" data-cat="@p.Cat" data-occasions="@p.Occasions">
                    <div class="product-card__img" style="background:#f0ede6;padding:0">
                        @if (p.IsNew)
                        {
                            <span class="product-card__badge">New In</span>
                        }
                        <img src="@p.Img" alt="@p.Name" style="width:100%;height:100%;object-fit:cover;display:block">
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__shop">@p.Shop</div>
                        <div class="product-card__name">@p.Name</div>
                        <div class="product-card__price" style="margin-bottom:8px">@p.Price <span>+ @p.Delivery delivery</span></div>
                        <div style="font-size:11px;color:#2d6a4f;font-weight:600;margin-bottom:12px">✉️ Free handwritten card</div>
                        <a asp-page="/Book/Step1"
                           asp-route-preselectedDate="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                           asp-route-preselectedShop="@p.Shop"
                           asp-route-preselectedItem="@p.Name"
                           asp-route-preselectedPrice="@p.Price.TrimStart('€')"
                           class="btn-add-cart">
                            <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1 1h2l2.5 8h7l1.5-5H4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="13" r="1" fill="currentColor"/><circle cx="11" cy="13" r="1" fill="currentColor"/></svg>
                            Send this gift
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- How it works strip -->
        <div class="hiw-strip" data-anim style="--anim-delay:0.18s">
            <div class="hiw-strip-item">
                <div class="hiw-strip-item__icon">🛍️</div>
                <div class="hiw-strip-item__title">Choose a gift</div>
                <div class="hiw-strip-item__desc">Pick from local shops or describe what you need</div>
            </div>
            <div class="hiw-strip-item">
                <div class="hiw-strip-item__icon">⏱</div>
