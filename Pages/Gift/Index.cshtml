@page "/gift"
@model IndexModel
@{
    ViewData["Title"] = "Gift & Deliver — Curated Local Gifts from South Tipperary";
}

@section Styles {
<style>
body { background: var(--gs-cream); }

/* ── Gift layout ── */
.gift-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    min-height: calc(100vh - 68px);
    align-items: start;
}
@@media (max-width: 1024px) { .gift-layout { grid-template-columns: 240px 1fr; } }
@@media (max-width: 768px)  { .gift-layout { grid-template-columns: 1fr; } }

/* ── Sidebar ── */
.gift-sidebar {
    background: var(--gs-bog-deep);
    min-height: calc(100vh - 68px);
    padding: 48px 32px;
    position: sticky;
    top: 68px;
    overflow-y: auto;
}
@@media (max-width: 768px) { .gift-sidebar { position: static; min-height: auto; padding: 36px 24px; } }

.gift-sidebar__eyebrow {
    font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gs-gold-soft); margin-bottom: 16px;
}
.gift-sidebar__heading {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(22px, 2.5vw, 30px);
    line-height: 1.18; letter-spacing: -0.02em;
    color: var(--gs-cream); margin-bottom: 16px;
}
.gift-sidebar__heading em { font-style: italic; color: var(--gs-gold); }
.gift-sidebar__sub {
    font-size: 13px; color: var(--gs-fog);
    line-height: 1.6; margin-bottom: 36px;
}

.gift-sidebar__section-label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gs-gold-soft);
    margin-bottom: 12px; padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}
.gift-cat-link {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border-radius: var(--r-sm);
    font-size: 14px; font-weight: 500;
    color: var(--gs-fog); text-decoration: none;
    margin-bottom: 2px;
    transition: background 0.15s, color 0.15s;
    cursor: pointer;
}
.gift-cat-link:hover { background: rgba(255,255,255,0.06); color: var(--gs-cream); }
.gift-cat-link.active { background: rgba(201,162,75,0.15); color: var(--gs-gold); font-weight: 600; }
.gift-cat-link__icon { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }
.gift-cat-link__count {
    margin-left: auto; font-size: 11px; font-family: var(--mono);
    background: rgba(255,255,255,0.08); padding: 2px 7px;
    border-radius: var(--r-pill); color: var(--gs-fog);
}

.gift-sidebar__cta {
    margin-top: 36px; padding-top: 28px;
    border-top: 1px solid rgba(255,255,255,0.08);
}
.gift-sidebar__info-item {
    display: flex; align-items: flex-start; gap: 10px;
    margin-bottom: 14px;
}
.gift-sidebar__info-item span:first-child { font-size: 16px; flex-shrink: 0; margin-top: 2px; }
.gift-sidebar__info-item p {
    font-size: 12px; color: var(--gs-fog); line-height: 1.5; margin: 0;
}

/* ── Main content ── */
.gift-main { padding: 48px 40px; background: var(--gs-cream); }
@@media (max-width: 1024px) { .gift-main { padding: 36px 24px; } }
@@media (max-width: 768px)  { .gift-main { padding: 28px 20px; } }

.gift-main-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 32px; flex-wrap: wrap; gap: 16px;
}
.gift-main-header h1 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(28px, 3vw, 40px); letter-spacing: -0.02em;
    color: var(--gs-bog-deep); margin: 0;
}

/* Filter tabs */
.gift-filters {
    display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px;
}
.filter-tab {
    padding: 8px 18px; border-radius: var(--r-pill);
    font-size: 13px; font-weight: 600;
    border: 1.5px solid var(--gs-mist);
    background: white; color: var(--gs-stone);
    cursor: pointer; transition: all 0.15s; text-decoration: none;
}
.filter-tab:hover { border-color: var(--gs-gold); color: var(--gs-bog-deep); }
.filter-tab.active {
    background: var(--gs-bog-deep); color: var(--gs-cream);
    border-color: var(--gs-bog-deep);
}

/* Product grid */
.product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}
@@media (max-width: 1200px) { .product-grid { grid-template-columns: repeat(2, 1fr); } }
@@media (max-width: 540px)  { .product-grid { grid-template-columns: 1fr; } }

.product-card {
    background: var(--gs-paper);
    border: 1.5px solid var(--gs-mist);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.2s var(--ease-spring), box-shadow 0.2s;
}
.product-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-2); }

.product-card__img {
    height: 180px;
    display: flex; align-items: center; justify-content: center;
    font-size: 52px;
    position: relative;
    overflow: hidden;
}
.product-card__badge {
    position: absolute; top: 12px; left: 12px;
    background: #2d6a4f; color: white;
    font-size: 10px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 4px 10px;
    border-radius: var(--r-pill);
}
.product-card__body { padding: 18px 20px 20px; }
.product-card__shop { font-size: 11px; color: var(--gs-stone); margin-bottom: 5px; }
.product-card__name {
    font-size: 15px; font-weight: 600; color: var(--gs-bog-deep);
    margin-bottom: 8px; line-height: 1.3;
}
.product-card__price {
    font-family: var(--mono); font-size: 18px; font-weight: 600;
    color: var(--gs-bog-deep); margin-bottom: 14px;
}
.product-card__price span { font-size: 13px; color: var(--gs-stone); font-family: var(--sans); font-weight: 400; }

.btn-add-cart {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 10px 16px;
    background: var(--gs-bog-deep); color: var(--gs-cream);
    border: none; border-radius: var(--r-sm);
    font-size: 14px; font-weight: 600;
    text-decoration: none; cursor: pointer;
    transition: background 0.15s, transform 0.15s var(--ease-spring);
}
.btn-add-cart:hover { background: var(--gs-bog); transform: scale(1.02); color: var(--gs-cream); }

/* ── How it works strip ── */
.hiw-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--gs-mist);
}
@@media (max-width: 900px) { .hiw-strip { grid-template-columns: 1fr 1fr; } }
@@media (max-width: 480px) { .hiw-strip { grid-template-columns: 1fr; } }
.hiw-strip-item { text-align: center; }
.hiw-strip-item__icon { font-size: 28px; margin-bottom: 10px; }
.hiw-strip-item__title { font-size: 14px; font-weight: 600; color: var(--gs-bog-deep); margin-bottom: 4px; }
.hiw-strip-item__desc { font-size: 12px; color: var(--gs-stone); line-height: 1.5; }
</style>
}

