        Send a gift →
    </a>
</div>

<!-- Spacer so content doesn't hide behind sticky bar on mobile -->
<div class="d-lg-none" style="height:72px"></div>

@section Scripts {
<script>
(function() {
    var activeCat     = 'all';
    var activeOccasion = 'all';

    function filterProducts() {
        var cards = document.querySelectorAll('.product-card');
        var shown = 0;
        var catCounts = {};
        cards.forEach(function(card) {
            var cat      = card.getAttribute('data-cat') || '';
            var occasions = card.getAttribute('data-occasions') || '';
            var catMatch = activeCat === 'all' || cat === activeCat;
            var occMatch = activeOccasion === 'all' || occasions.split(',').indexOf(activeOccasion) !== -1;
            if (catMatch && occMatch) {
                card.style.display = '';
                shown++;
            } else {
                card.style.display = 'none';
            }
            // Count per category (regardless of cat filter, but respecting occasion filter)
            if (activeOccasion === 'all' || occasions.split(',').indexOf(activeOccasion) !== -1) {
                catCounts[cat] = (catCounts[cat] || 0) + 1;
            }
        });
        var countEl = document.getElementById('productCount');
        if (countEl) countEl.textContent = shown;
        var mobileCount = document.getElementById('mobileProductCount');
        if (mobileCount) mobileCount.textContent = shown;
        // Update sidebar badge counts
        var total = 0;
        Object.keys(catCounts).forEach(function(c) { total += catCounts[c]; });
        document.querySelectorAll('.gift-cat-link__count').forEach(function(el) {
            var btn = el.closest('[data-cat]');
            if (!btn) return;
            var cat = btn.getAttribute('data-cat');
            el.textContent = cat === 'all' ? total : (catCounts[cat] || 0);
        });
    }

    // Category filter tabs (main content area)
    document.querySelectorAll('.filter-tab[data-cat]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            activeCat = this.getAttribute('data-cat');
            document.querySelectorAll('.filter-tab[data-cat]').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            // Sync sidebar
            document.querySelectorAll('.gift-cat-link[data-cat]').forEach(function(b) {
                b.classList.toggle('active', b.getAttribute('data-cat') === activeCat);
            });
            filterProducts();
        });
    });

    // Sidebar category links
    document.querySelectorAll('.gift-cat-link[data-cat]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            activeCat = this.getAttribute('data-cat');
            document.querySelectorAll('.gift-cat-link[data-cat]').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            // Sync main tabs
            document.querySelectorAll('.filter-tab[data-cat]').forEach(function(b) {
                b.classList.toggle('active', b.getAttribute('data-cat') === activeCat);
            });
            filterProducts();
            // Scroll to product grid on mobile
            var grid = document.querySelector('.product-grid');
            if (grid && window.innerWidth < 768) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    // Occasion filter tabs
    document.querySelectorAll('.filter-tab[data-occasion]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            activeOccasion = this.getAttribute('data-occasion');
            document.querySelectorAll('.filter-tab[data-occasion]').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            filterProducts();
        });
    });

    // Sync gift-date picker → book button URL
    var giftDateInput = document.getElementById('giftDate');
    var giftBookBtn   = document.getElementById('giftBookBtn');
    if (giftDateInput && giftBookBtn) {
        giftDateInput.addEventListener('change', function() {
            giftBookBtn.href = '/Book/Step1?preselectedDate=' + encodeURIComponent(giftDateInput.value);
        });
    }
})();
</script>
}
