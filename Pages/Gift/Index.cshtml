<!-- Mobile sticky bottom CTA (visible only on small/tablet screens) -->
<div class="d-flex d-lg-none align-items-center justify-content-between gap-3 px-4 py-3"
     style="position:fixed;bottom:0;left:0;right:0;z-index:100;
            background:rgba(250,246,236,0.95);backdrop-filter:blur(12px);
            border-top:1px solid var(--gs-mist);box-shadow:0 -4px 16px rgba(20,17,12,0.08)">
