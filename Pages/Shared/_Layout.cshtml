<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – TippSend</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<nav class="navbar navbar-expand-lg gs-nav" id="mainNavbar">
    <div class="container-xl">
        <a class="navbar-brand gs-brand" asp-page="/Index">
            <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="13" cy="13" r="11" stroke="#1F3A2E" stroke-width="1.6"/>
                <!-- minute hand pointing to ~11 -->
                <line x1="13" y1="13" x2="10" y2="5.5" stroke="#1F3A2E" stroke-width="1.4" stroke-linecap="round"/>
                <!-- hour hand pointing to ~2 -->
                <line x1="13" y1="13" x2="18.5" y2="9" stroke="#C9A24B" stroke-width="1.6" stroke-linecap="round"/>
                <!-- centre dot -->
                <circle cx="13" cy="13" r="1.5" fill="#1F3A2E"/>
            </svg>
            <span class="gs-brand__text">Tipp<em>Send</em></span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navCollapse"
                aria-controls="navCollapse" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navCollapse">
            <ul class="navbar-nav ms-4 me-auto gap-1">
                <li class="nav-item"><a class="nav-link" href="/gift">Gift &amp; Deliver</a></li>
                <li class="nav-item"><a class="nav-link" href="/send">Pickup &amp; Drop</a></li>
                <li class="nav-item"><a class="nav-link" href="/partner">Partner With Us</a></li>
                <li class="nav-item"><a class="nav-link" href="/support">Support</a></li>
            </ul>
            <div class="d-flex gap-2 align-items-center">
                <a class="btn btn-sm btn-outline-cream" asp-page="/Track/Index">Track order</a>
                <a class="btn btn-sm btn-gold" href="/gift">Send a gift</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-sm btn-outline-cream" asp-page="/Operator/Dashboard">Dashboard</a>
                }
            </div>
        </div>
    </div>
</nav>

@RenderBody()

<footer class="gs-footer">
    <div class="container-xl">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-4">
                <div class="footer-brand mb-3">
                    <img src="~/Logo4.png" alt="TippSend"
                         style="height:32px;width:auto;filter:brightness(0) invert(1) opacity(0.9)" />
                </div>
                <p class="mb-2" style="color:var(--gs-mist)">Three simple services. One local team.</p>
                <p class="mb-0" style="color:var(--gs-stone);font-size:0.8rem">South Tipperary, Ireland · Clonmel &amp; surrounding towns</p>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-col-head">Services</div>
                <div class="footer-links">
                    <a href="/gift">Gift &amp; Deliver</a>
                    <a href="/send">Pickup &amp; Drop</a>
                    <a href="/partner">Partner With Us</a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-col-head">Help</div>
                <div class="footer-links">
                    <a asp-page="/Track/Index">Track an order</a>
                    <a href="mailto:hello@tippsend.ie">Contact us</a>
                    <a href="/support">FAQ &amp; Support</a>
                    <a asp-page="/Privacy">Privacy policy</a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-col-head">Business</div>
                <div class="footer-links">
                    <a href="/partner">Shop Partner</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Operator/Dashboard">Operator dashboard</a>
                        <a asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Index">Sign out</a>
                    }
                    else
                    {
                        <a asp-page="/Operator/Dashboard">Operator login</a>
                    }
                </div>
            </div>
        </div>
        <hr class="mt-5" style="border-color:rgba(255,255,255,0.08)" />
        <p class="mb-0 text-center" style="font-size:0.78rem;color:var(--gs-stone)">
            © @DateTime.Now.Year TippSend · Clonmel, Co. Tipperary · <a href="mailto:hello@tippsend.ie">hello@tippsend.ie</a>
        </p>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Scroll-shrink nav
(function() {
    var nav = document.getElementById('mainNavbar');
    window.addEventListener('scroll', function() {
        nav.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });
})();

// Blur-slide-up entrance animations via IntersectionObserver
(function() {
    var els = document.querySelectorAll('[data-anim]');
    if (!els.length || !('IntersectionObserver' in window)) {
        els.forEach(function(el) { el.classList.add('in'); });
        return;
    }
    var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
    }, { threshold: 0.12 });
    els.forEach(function(el) { io.observe(el); });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
