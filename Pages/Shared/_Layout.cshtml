<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – TippSend</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pilot.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<a class="visually-hidden-focusable" href="#main-content">Skip to content</a>
@if (Context.RequestServices.GetRequiredService<TippSendApp.Services.PilotService>().Preview) { <div class="pilot-preview">Local preview · sample routes · no payment or external notifications from the new request forms</div> }

<nav class="navbar navbar-expand-lg gs-nav" id="mainNavbar">
    <div class="container-xl">
        <a class="navbar-brand gs-brand" asp-page="/Index">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="10" width="18" height="11" rx="1.2" stroke="#1F3A2E" stroke-width="1.5"/>
                <rect x="5" y="7" width="14" height="4" rx="1" stroke="#1F3A2E" stroke-width="1.5"/>
                <line x1="12" y1="7" x2="12" y2="21" stroke="#1F3A2E" stroke-width="1.5"/>
                <path d="M12 7C12 7 9 7 8 5.5C7 4 8.5 2 10 3C11 3.5 12 5 12 7Z" stroke="#C9A24B" stroke-width="1.3" fill="none" stroke-linecap="round"/>
                <path d="M12 7C12 7 15 7 16 5.5C17 4 15.5 2 14 3C13 3.5 12 5 12 7Z" stroke="#C9A24B" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            </svg>
            <span class="gs-brand__text">Tipp<em>Send</em></span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navCollapse"
                aria-controls="navCollapse" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navCollapse">
            <ul class="navbar-nav ms-4 me-auto gap-1">
                <li class="nav-item"><a class="nav-link" href="/send">Send an Item</a></li>
                <li class="nav-item"><a class="nav-link" href="/partner">For Businesses</a></li>
                <li class="nav-item"><a class="nav-link" href="/support">Support</a></li>
            </ul>
            <div class="d-flex gap-2 align-items-center">
                <a class="btn btn-sm btn-outline-cream" asp-page="/Track/Index">Track order</a>
                <a class="btn btn-sm btn-gold" href="/send">Arrange delivery</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-sm btn-outline-cream" asp-page="/Operator/Dashboard">Dashboard</a>
                }
            </div>
        </div>
    </div>
</nav>

@RenderBody()

<footer class="gs-footer">
    <div class="container-xl">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-4">
                <div class="footer-brand mb-3" style="font-family:var(--display);font-size:1.5rem;color:var(--gs-gold);letter-spacing:-0.01em">
                    Tipp<em>Send</em>
                </div>
                <p class="mb-2" style="color:var(--gs-mist)">Local delivery for businesses and everyday items.</p>
                <p class="mb-0" style="color:var(--gs-stone);font-size:0.8rem">South Tipperary, Ireland · Clonmel · Cahir · Cashel · Tipperary Town</p>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-col-head">Services</div>
                <div class="footer-links">
                    <a href="/send">Send an Item</a>
                    <a href="/partner">For Businesses</a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-col-head">Help</div>
                <div class="footer-links">
                    <a asp-page="/Track/Index">Track an order</a>
                    <a href="mailto:hello@tippsend.ie">Contact us</a>
                    <a href="/support">FAQ &amp; Support</a>
                    <a asp-page="/Privacy">Privacy policy</a>
                    <a href="/terms">Terms &amp; conditions</a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="footer-col-head">Business</div>
                <div class="footer-links">
                    <a href="/partner">Business deliveries</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Operator/Dashboard">Operator dashboard</a>
                        <a asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Index">Sign out</a>
                    }
                    else
                    {
                        <a asp-page="/Operator/Dashboard">Operator login</a>
                    }
                </div>
            </div>
        </div>
        <hr class="mt-5" style="border-color:rgba(255,255,255,0.08)" />
        <p class="mb-0 text-center" style="font-size:0.78rem;color:var(--gs-stone)">
            © @DateTime.Now.Year TippSend · Clonmel, Co. Tipperary · <a href="mailto:hello@tippsend.ie">hello@tippsend.ie</a>
        </p>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Scroll-shrink nav
(function() {
    var nav = document.getElementById('mainNavbar');
    window.addEventListener('scroll', function() {
        nav.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });
})();

// Blur-slide-up entrance animations via IntersectionObserver
(function() {
    var els = document.querySelectorAll('[data-anim]');
    if (!els.length || !('IntersectionObserver' in window)) {
        els.forEach(function(el) { el.classList.add('in'); });
        return;
    }
    var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
    }, { threshold: 0.12 });
    els.forEach(function(el) { io.observe(el); });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
