@page "/marketplace"
@model TippSendApp.Pages.Marketplace.IndexModel
@{
    ViewData["Title"] = "Safe Swap Clonmel — Neutral Meetup & Delivery for Facebook Marketplace";
}

@section Styles {
<style>
body { background: var(--gs-cream); }

.mkt-hero {
    background: var(--gs-bog-deep);
    padding: 72px 0 56px;
    position: relative;
    overflow: hidden;
}
.mkt-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(201,162,75,0.12) 0%, transparent 60%);
    pointer-events: none;
}
.mkt-hero-inner { position: relative; z-index: 2; }
.mkt-hero-eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gs-gold); margin-bottom: 20px;
}
.mkt-hero-h1 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1.08; letter-spacing: -0.02em;
    color: var(--gs-cream); margin-bottom: 20px;
}
.mkt-hero-h1 em { font-style: italic; color: var(--gs-gold); }
.mkt-hero-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--gs-fog); line-height: 1.65; margin-bottom: 36px; max-width: 560px;
}

.mkt-how-card {
    background: white;
    border: 1px solid var(--gs-mist);
    border-radius: var(--r-md);
    padding: 28px 24px;
    text-align: center;
}
.mkt-how-card__num {
    width: 40px; height: 40px;
    background: var(--gs-bog-deep);
    color: var(--gs-gold);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono); font-size: 16px; font-weight: 700;
    margin: 0 auto 16px;
}
.mkt-how-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--gs-bog-deep); }
.mkt-how-card p  { font-size: 13px; color: var(--gs-stone); line-height: 1.55; margin: 0; }

.mkt-usecase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
}
.mkt-usecase {
    background: var(--gs-paper);
    border: 1px solid var(--gs-mist);
    border-radius: var(--r-sm);
    padding: 16px 18px;
    display: flex; align-items: flex-start; gap: 12px;
}
.mkt-usecase__icon { font-size: 22px; flex-shrink: 0; }
.mkt-usecase__text { font-size: 13px; color: var(--gs-bog-deep); font-weight: 500; }
.mkt-usecase__sub  { font-size: 11px; color: var(--gs-stone); margin-top: 2px; }

.mkt-price-strip {
    background: var(--gs-bog-deep);
    border-radius: var(--r-md);
    padding: 28px 32px;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;
}
.mkt-price-strip__price {
    font-family: var(--mono); font-size: 36px; font-weight: 700; color: var(--gs-gold);
}
.mkt-price-strip__label { font-size: 13px; color: var(--gs-fog); margin-top: 4px; }
</style>
}

<!-- Hero -->
<section class="mkt-hero">
    <div class="container mkt-hero-inner">
        <div>
            <div class="mkt-hero-eyebrow" data-anim>Safe swap · Clonmel & South Tipperary</div>
            <h1 class="mkt-hero-h1" data-anim style="--anim-delay:0.06s">
                Sold it on Marketplace?<br><em>We'll deliver it.</em>
            </h1>
            <p class="mkt-hero-sub" data-anim style="--anim-delay:0.1s">
                Skip the awkward doorstep meetup. TippSend collects from the seller and delivers to the buyer —
                covering Clonmel and all of South Tipperary. Safe, timed, and insured.
            </p>
            <div class="d-flex gap-3 flex-wrap" data-anim style="--anim-delay:0.14s">
                <a href="/send" class="btn btn-gold" style="font-size:16px;padding:14px 28px">Book a safe swap →</a>
                <a href="https://wa.me/353899258702?text=Hi%2C%20I%27d%20like%20to%20book%20a%20safe%20swap%20delivery." target="_blank" rel="noopener"
                   class="btn d-flex align-items-center gap-2"
                   style="background:#25D366;color:#fff;font-size:15px;padding:14px 24px;border:none">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.570-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                    WhatsApp us
                </a>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="py-5" style="background:var(--gs-cream)">
    <div class="container" style="max-width:900px">
        <div class="text-center mb-4" data-anim>
            <div class="eyebrow mb-2">How it works</div>
            <h2 style="font-family:var(--display);font-weight:400;font-size:clamp(24px,3vw,36px);color:var(--gs-bog-deep)">
                Three steps. Done.
            </h2>
        </div>
        <div class="row g-3">
            <div class="col-md-4" data-anim>
                <div class="mkt-how-card">
                    <div class="mkt-how-card__num">1</div>
                    <h3>Book online or WhatsApp</h3>
                    <p>Tell us the seller's address, your address, and your preferred time. Takes 2 minutes.</p>
                </div>
            </div>
            <div class="col-md-4" data-anim style="--anim-delay:0.06s">
                <div class="mkt-how-card">
                    <div class="mkt-how-card__num">2</div>
                    <h3>We collect from the seller</h3>
                    <p>Our driver picks up the item at the agreed time, pays cash on your behalf if needed, and confirms it's as described.</p>
                </div>
            </div>
            <div class="col-md-4" data-anim style="--anim-delay:0.12s">
                <div class="mkt-how-card">
                    <div class="mkt-how-card__num">3</div>
                    <h3>Delivered to your door</h3>
                    <p>You get a doorstep photo when it arrives. No meetups, no stranger at your door.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Use cases -->
<section class="py-5" style="background:var(--gs-paper)">
    <div class="container" style="max-width:900px">
        <div class="mb-4" data-anim>
            <div class="eyebrow mb-2">What people swap</div>
            <h2 style="font-family:var(--display);font-weight:400;font-size:clamp(22px,2.8vw,32px);color:var(--gs-bog-deep)">
                Anything that fits in a car
            </h2>
        </div>
        <div class="mkt-usecase-grid">
            <div class="mkt-usecase" data-anim>
                <div class="mkt-usecase__icon">📱</div>
                <div><div class="mkt-usecase__text">Phones & electronics</div><div class="mkt-usecase__sub">Facebook Marketplace, Done Deal</div></div>
            </div>
            <div class="mkt-usecase" data-anim style="--anim-delay:0.04s">
                <div class="mkt-usecase__icon">👗</div>
                <div><div class="mkt-usecase__text">Clothes & shoes</div><div class="mkt-usecase__sub">Vinted, Depop pickups</div></div>
            </div>
            <div class="mkt-usecase" data-anim style="--anim-delay:0.08s">
                <div class="mkt-usecase__icon">🪑</div>
                <div><div class="mkt-usecase__text">Small furniture</div><div class="mkt-usecase__sub">Chairs, shelving, lamps</div></div>
            </div>
            <div class="mkt-usecase" data-anim style="--anim-delay:0.12s">
                <div class="mkt-usecase__icon">🎮</div>
                <div><div class="mkt-usecase__text">Games & toys</div><div class="mkt-usecase__sub">Consoles, bikes, kids gear</div></div>
            </div>
            <div class="mkt-usecase" data-anim style="--anim-delay:0.16s">
                <div class="mkt-usecase__icon">📚</div>
                <div><div class="mkt-usecase__text">Books & media</div><div class="mkt-usecase__sub">Textbooks, DVDs, vinyl</div></div>
            </div>
            <div class="mkt-usecase" data-anim style="--anim-delay:0.20s">
                <div class="mkt-usecase__icon">🏋️</div>
                <div><div class="mkt-usecase__text">Sports equipment</div><div class="mkt-usecase__sub">Weights, bikes, rackets</div></div>
            </div>
        </div>
        <p class="mt-3" style="font-size:12px;color:var(--gs-stone)">Max 60 kg · max 120×60×60 cm. No liquids, no sharp items.</p>
    </div>
</section>

<!-- Price strip -->
<section class="py-5" style="background:var(--gs-cream)">
    <div class="container" style="max-width:700px">
        <div class="mkt-price-strip" data-anim>
            <div>
                <div class="mkt-price-strip__price">From €6</div>
                <div class="mkt-price-strip__label">Clonmel to Clonmel · no hidden fees</div>
            </div>
            <div>
                <a href="/send" class="btn btn-gold" style="font-size:15px;padding:14px 28px">See all prices →</a>
            </div>
        </div>
        <div class="row g-3 mt-3 text-center">
            <div class="col-4">
                <div class="p-3 rounded" style="background:white;border:1px solid var(--gs-mist)">
                    <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:var(--gs-bog-deep)">€6</div>
                    <div style="font-size:11px;color:var(--gs-stone)">Within Clonmel</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded" style="background:white;border:1px solid var(--gs-mist)">
                    <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:var(--gs-bog-deep)">€10</div>
                    <div style="font-size:11px;color:var(--gs-stone)">Cahir, Fethard, Carrick</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 rounded" style="background:white;border:1px solid var(--gs-mist)">
                    <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:var(--gs-bog-deep)">€14</div>
                    <div style="font-size:11px;color:var(--gs-stone)">Cashel & further</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="py-5" style="background:var(--gs-bog-deep)">
    <div class="container text-center" style="max-width:560px">
        <h2 data-anim style="font-family:var(--display);font-weight:400;font-size:clamp(26px,3.5vw,40px);color:var(--gs-cream);margin-bottom:16px">
            No more stranger meetups.
        </h2>
        <p data-anim style="--anim-delay:0.06s;font-size:16px;color:var(--gs-fog);margin-bottom:32px">
            Book online in 2 minutes or drop us a WhatsApp. We cover Clonmel and 9 surrounding towns.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap" data-anim style="--anim-delay:0.1s">
            <a href="/send" class="btn btn-gold" style="font-size:16px;padding:14px 28px">Book a delivery →</a>
            <a href="https://wa.me/353899258702?text=Hi%2C%20I%27d%20like%20to%20book%20a%20safe%20swap." target="_blank" rel="noopener"
               class="btn d-flex align-items-center gap-2"
               style="background:#25D366;color:#fff;font-size:15px;padding:14px 22px;border:none">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.570-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                WhatsApp us
            </a>
        </div>
    </div>
</section>
