@page
@model TippSendApp.Pages.Admin.DispatchModel
@{ViewData["Title"]="Pilot dispatch";}
<main id="main-content" class="pilot-wrap" style="padding-top:40px;padding-bottom:60px"><h1>Pilot dispatch</h1><p class="pilot-note">Publish only committed, costed runs. Requests reserve a slot until cancelled. Closing a route stops new requests and retains existing requests.</p><div asp-validation-summary="All" role="alert"></div>
<h2>Publish a departure</h2><form method="post" asp-page-handler="Publish" class="pilot-panel pilot-form"><div class="pilot-fields"><div><label asp-for="NewRoute.Corridor">Corridor / town boundary</label><input asp-for="NewRoute.Corridor" class="form-control"></div><div><label asp-for="NewRoute.DepartureDate">Delivery date</label><input asp-for="NewRoute.DepartureDate" type="date" class="form-control"></div><div><label asp-for="NewRoute.Window">Delivery window</label><input asp-for="NewRoute.Window" class="form-control"></div><div><label asp-for="NewRoute.Cutoff">Booking cutoff (Irish time)</label><input asp-for="NewRoute.Cutoff" type="datetime-local" class="form-control"></div><div><label asp-for="NewRoute.Capacity">Maximum drops</label><input asp-for="NewRoute.Capacity" class="form-control"></div><div><label asp-for="NewRoute.Price">Price per drop (€)</label><input asp-for="NewRoute.Price" class="form-control"></div></div><button class="pilot-button mt-3">Publish route</button></form>
<h2 class="mt-5">Departures</h2>@foreach(var r in Model.Routes){<div class="pilot-panel mb-2"><strong>@r.Label</strong><p class="pilot-note">@Model.Requests.Count(x=>x.RouteId==r.Id && x.Status!="Cancelled") / @r.Capacity slots reserved · @(r.Open?"Open":"Closed")</p><form method="post" asp-page-handler="Close"><input type="hidden" name="id" value="@r.Id"><button class="pilot-button secondary">Close to new requests</button></form></div>}
<h2 class="mt-5">Delivery requests</h2>@foreach(var r in Model.Requests){<article class="pilot-panel mb-3"><strong>@r.Reference · @r.Service · @r.Status</strong><p>@r.PickupAddress (@r.PickupEircode) → @r.DropoffAddress (@r.DropoffEircode)</p><p class="pilot-note">@r.PreferredDate.ToString("d MMM yyyy") · @r.PreferredTime<br>@r.ItemDescription · @r.WeightKg kg · declared €@r.DeclaredValue<br>Sender: @r.ContactName · @r.ContactEmail · @r.ContactPhone<br>Recipient: @r.RecipientName · @r.RecipientPhone<br>@r.SpecialInstructions</p><form method="post" asp-page-handler="Update" class="pilot-form"><input type="hidden" name="reference" value="@r.Reference"><label for="status-@r.Reference">Status</label><select id="status-@r.Reference" name="status" class="form-select">@foreach(var status in new[]{"Requested","Quoted","Accepted","Completed","Cancelled"}){<option selected="@(status==r.Status)" value="@status">@status</option>}</select><label class="mt-2" for="price-@r.Reference">Agreed / quoted price (€)</label><input id="price-@r.Reference" name="price" value="@r.QuotedPrice" type="number" min="0" step="0.01" class="form-control"><button class="pilot-button mt-3">Save request</button></form></article>}
</main>
