@page
@model TippSendApp.Pages.Admin.B2BAccounts.InvoiceModel
@{
    ViewData["Title"] = "B2B Invoice";
    var months = Enumerable.Range(1, 12).Select(m => new { Value = m, Label = new DateTime(2000, m, 1).ToString("MMMM") });
    var years = Enumerable.Range(DateTime.Today.Year - 1, 3);
}

<div class="admin-header">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <a asp-page="/Admin/Index" style="color:var(--gs-fog);text-decoration:none">← Admin</a>
            <span class="footer-brand" style="font-size:1.1rem">B2B Invoice</span>
        </div>
        @if (Model.SelectedAccount is not null && Model.InvoiceOrders.Any())
        {
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">🖨 Print / Save PDF</button>
        }
    </div>
</div>

<div class="container-fluid py-4" style="max-width:800px">

    <!-- Selector -->
    <form method="get" class="d-flex gap-2 flex-wrap align-items-end mb-4">
        <div>
            <label class="form-label small fw-semibold mb-1">Account</label>
            <select name="AccountId" class="form-select" style="min-width:220px">
                <option value="">— Select account —</option>
                @foreach (var a in Model.Accounts)
                {
                    if (a.Id == Model.AccountId)
                    { <option value="@a.Id" selected>@a.BusinessName</option> }
                    else
                    { <option value="@a.Id">@a.BusinessName</option> }
                }
            </select>
        </div>
        <div>
            <label class="form-label small fw-semibold mb-1">Month</label>
            <select name="Month" class="form-select" style="width:140px">
                @foreach (var m in months)
                {
                    if (m.Value == Model.Month)
                    { <option value="@m.Value" selected>@m.Label</option> }
                    else
                    { <option value="@m.Value">@m.Label</option> }
                }
            </select>
        </div>
        <div>
            <label class="form-label small fw-semibold mb-1">Year</label>
            <select name="Year" class="form-select" style="width:100px">
                @foreach (var y in years)
                {
                    if (y == Model.Year)
                    { <option value="@y" selected>@y</option> }
                    else
                    { <option value="@y">@y</option> }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-dark">Generate</button>
    </form>

    @if (Model.SelectedAccount is null)
    {
        <p class="text-muted">Select an account above to generate an invoice.</p>
    }
    else
    {
        <!-- Invoice -->
        <div id="invoiceDoc" style="background:white;border:1px solid #dee2e6;border-radius:8px;padding:40px">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <div style="font-family:var(--display);font-size:28px;font-weight:500;color:var(--gs-bog-deep)">TippSend</div>
                    <div style="font-size:12px;color:#666">South Tipperary, Ireland</div>
                    <div style="font-size:12px;color:#666">tippsend.ie</div>
                </div>
                <div class="text-end">
                    <div style="font-size:22px;font-weight:700;letter-spacing:0.04em">INVOICE</div>
                    <div style="font-size:12px;color:#666;margin-top:4px">@Model.MonthLabel</div>
                    <div style="font-size:12px;color:#666">Issued: @DateTime.Today.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <hr />

            <!-- Bill to -->
            <div class="mb-4">
                <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#999;margin-bottom:6px">Bill To</div>
                <div style="font-weight:600">@Model.SelectedAccount.BusinessName</div>
                <div style="font-size:13px;color:#444">@Model.SelectedAccount.ContactName</div>
                <div style="font-size:13px;color:#444">@Model.SelectedAccount.Address, @Model.SelectedAccount.Town</div>
                <div style="font-size:13px;color:#444">@Model.SelectedAccount.ContactEmail</div>
            </div>

            <!-- Line items -->
            <table class="table table-sm" style="font-size:13px">
                <thead style="background:#f8f9fa">
                    <tr>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>Monthly retainer — @Model.MonthLabel</strong>
                        </td>
                        <td class="text-end" style="font-family:var(--mono)">€@Model.SelectedAccount.MonthlyRetainer.ToString("N2")</td>
                    </tr>
                    @if (Model.InvoiceOrders.Any())
                    {
                        <tr>
                            <td colspan="2" class="pt-3 pb-1" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#999">
                                Deliveries (@Model.InvoiceOrders.Count)
                            </td>
                        </tr>
                        @foreach (var o in Model.InvoiceOrders)
                        {
                            <tr>
                                <td style="padding-left:16px">
                                    @o.DeliveryDate.ToString("dd MMM") — @o.Item → @o.Recipient
                                    <span style="font-size:11px;color:#999;margin-left:8px">@o.Reference</span>
                                </td>
                                <td class="text-end" style="font-family:var(--mono)">€@o.Total.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td style="font-size:12px;color:#666">Delivery subtotal</td>
                            <td class="text-end" style="font-family:var(--mono);font-size:12px;color:#666">€@Model.DeliverySubtotal.ToString("N2")</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-muted" style="font-size:12px;padding-left:16px">No deliveries in @Model.MonthLabel</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="border-top:2px solid #333">
                        <th style="font-size:15px">Total due</th>
                        <th class="text-end" style="font-size:15px;font-family:var(--mono)">€@Model.InvoiceTotal.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>

            <div style="font-size:11px;color:#999;margin-top:24px">
                Payment due within 14 days of invoice date. Thank you for partnering with TippSend.
            </div>
        </div>
    }
</div>

<style>
@@media print {
    .admin-header, form, .btn { display: none !important; }
    body { background: white !important; }
    #invoiceDoc { border: none !important; }
}
</style>
