@page
@model TippSendApp.Pages.Admin.B2BAccounts.IndexModel
@{
    ViewData["Title"] = "B2B Accounts";
}

<div class="admin-header">
    <div class="container-fluid d-flex align-items-center gap-3">
        <a asp-page="/Admin/Index" style="color:var(--gs-fog);text-decoration:none">← Admin</a>
        <span class="footer-brand" style="font-size:1.1rem">B2B Accounts</span>
    </div>
</div>

<div class="container-fluid py-3" style="max-width:1100px">

    <!-- Add form -->
    <div class="card mb-4">
        <div class="card-header fw-semibold" style="background:var(--gs-paper)">Add B2B account</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create">
                <div class="row g-2">
                    <div class="col-md-3"><input asp-for="NewAccount.BusinessName" class="form-control" placeholder="Business name *" /></div>
                    <div class="col-md-2"><input asp-for="NewAccount.ContactName" class="form-control" placeholder="Contact name *" /></div>
                    <div class="col-md-2"><input asp-for="NewAccount.ContactEmail" class="form-control" placeholder="Email" /></div>
                    <div class="col-md-2"><input asp-for="NewAccount.ContactPhone" class="form-control" placeholder="Phone" /></div>
                    <div class="col-md-3"><input asp-for="NewAccount.Address" class="form-control" placeholder="Address" /></div>
                    <div class="col-md-2">
                        <select asp-for="NewAccount.Town" class="form-select">
                            <option value="">Town</option>
                            @foreach (var t in TippSendApp.Pages.Book.Step2Model.IrishTowns)
                            { <option>@t</option> }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input asp-for="NewAccount.MonthlyRetainer" class="form-control" type="number" step="0.01" placeholder="Monthly" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input asp-for="NewAccount.PerDeliveryRate" class="form-control" type="number" step="0.01" placeholder="Per delivery" />
                        </div>
                    </div>
                    <div class="col-auto"><button class="btn btn-gold">Add account</button></div>
                </div>
            </form>
        </div>
    </div>

    <!-- Accounts table -->
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-dark">
                <tr><th>Business</th><th>Contact</th><th>Town</th><th>Retainer/mo</th><th>Per delivery</th><th>Active</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Accounts)
                {
                    <tr class="@(!a.IsActive ? "table-secondary" : "")">
                        <td class="fw-semibold small">@a.BusinessName</td>
                        <td class="small">@a.ContactName · @a.ContactPhone</td>
                        <td class="small">@a.Town</td>
                        <td class="time-mono small">€@a.MonthlyRetainer.ToString("F2")</td>
                        <td class="time-mono small">€@a.PerDeliveryRate.ToString("F2")</td>
                        <td>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@a.Id">
                                <button class="btn btn-sm @(a.IsActive ? "btn-success" : "btn-secondary")">
                                    @(a.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-page="Index" asp-route-EditId="@(Model.EditId == a.Id ? 0 : a.Id)"
                               class="btn btn-sm @(Model.EditId == a.Id ? "btn-dark" : "btn-outline-secondary")">Edit</a>
                        </td>
                    </tr>

                    @if (Model.EditId == a.Id)
                    {
                        <tr style="background:#f8f9fa">
                            <td colspan="7" class="p-3">
                                <form method="post" asp-page-handler="Edit">
                                    <input type="hidden" asp-for="EditAccount.Id" value="@a.Id" />
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold mb-1">Business name</label>
                                            <input name="EditAccount.BusinessName" class="form-control form-control-sm" value="@a.BusinessName" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold mb-1">Contact name</label>
                                            <input name="EditAccount.ContactName" class="form-control form-control-sm" value="@a.ContactName" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold mb-1">Email</label>
                                            <input name="EditAccount.ContactEmail" class="form-control form-control-sm" value="@a.ContactEmail" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold mb-1">Phone</label>
                                            <input name="EditAccount.ContactPhone" class="form-control form-control-sm" value="@a.ContactPhone" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold mb-1">Address</label>
                                            <input name="EditAccount.Address" class="form-control form-control-sm" value="@a.Address" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold mb-1">Town</label>
                                            <select name="EditAccount.Town" class="form-select form-select-sm">
                                                @foreach (var t in TippSendApp.Pages.Book.Step2Model.IrishTowns)
                                                {
                                                    if (t == a.Town) { <option selected>@t</option> }
                                                    else { <option>@t</option> }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold mb-1">Monthly retainer €</label>
                                            <input name="EditAccount.MonthlyRetainer" type="number" step="0.01" class="form-control form-control-sm" value="@a.MonthlyRetainer" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold mb-1">Per delivery €</label>
                                            <input name="EditAccount.PerDeliveryRate" type="number" step="0.01" class="form-control form-control-sm" value="@a.PerDeliveryRate" />
                                        </div>
                                        <div class="col-auto d-flex align-items-end">
                                            <button type="submit" class="btn btn-gold btn-sm">Save</button>
                                        </div>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
