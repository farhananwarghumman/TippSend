@page
@model TippSendApp.Pages.Admin.BackupModel
@{ViewData["Title"]="Back up TippSend";}
<main id="main-content" class="pilot-wrap" style="padding:40px 0 64px;max-width:720px">
<a href="/Admin">← Admin</a><h1 class="mt-3">Back up TippSend.</h1>
<section class="pilot-panel"><p>Download the database, delivery photos and account encryption keys in one archive.</p>
<p>Keep a copy outside Railway before major changes and after taking bookings. This archive contains private customer information and account keys; store it securely.</p>
<form method="post" asp-page-handler="Download"><button class="pilot-button">Download backup →</button></form>
<p class="pilot-note mt-3">Restore instructions are included. Test restoration in an empty local database first. Automatic off-site backups are not configured yet.</p>
</section></main>
