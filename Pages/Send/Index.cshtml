@page "/send"
@model TippSendApp.Pages.Send.IndexModel
@{ ViewData["Title"]="Send an item"; var received=Model.Received; }
<main id="main-content" class="pilot-wrap" style="padding-top:48px;padding-bottom:64px">
<div class="pilot-kicker">For businesses and personal deliveries</div><h1 style="font-size:44px;font-weight:650;letter-spacing:-.04em">Send an item.</h1><p class="pilot-lead">Arrange collection from a home or business and delivery to another address. Choose a shared run or ask for a separate trip. You can submit a request at any time. We confirm the details and price before you pay.</p>
@if(received is not null) { <div class="pilot-success" role="status"><h2>Request received.</h2><p>Your reference is <strong>@received</strong>. Keep this reference when contacting contact@tippsend.ie.</p><p class="mb-0">This is a request, not a confirmed delivery. No payment has been taken. We will agree the price and availability before acceptance.</p></div> }
else {
<div class="pilot-grid pilot-book-grid" style="align-items:start;margin-top:32px">
<form method="post" class="pilot-panel pilot-form" id="delivery-form">
<div asp-validation-summary="All" role="alert" tabindex="-1" id="form-errors"></div><p class="pilot-note">All fields are required unless marked optional.</p>
<fieldset><legend>1. Choose your service</legend><div class="pilot-choice"><input asp-for="Input.Service" type="radio" value="Scheduled" id="scheduled"><label for="scheduled">Scheduled delivery<small>Join an available shared run at its published price.</small></label></div><div class="pilot-choice"><input asp-for="Input.Service" type="radio" value="Dedicated" id="dedicated"><label for="dedicated">Separate delivery<small>Request a quote for your own trip, based on time, distance and handling.</small></label></div>
<div id="scheduled-fields"><label asp-for="Input.RouteId">Available delivery times</label><select asp-for="Input.RouteId" class="form-select"><option value="">Choose a delivery time</option>@foreach(var r in Model.Routes) { <option value="@r.Id">@r.Label</option> }</select><span asp-validation-for="Input.RouteId" class="text-danger"></span>@if(Model.Routes.Count==0) { <p class="pilot-note mt-2">No scheduled runs are currently available. Choose “Separate delivery” to request a quote.</p> }<p class="pilot-note mt-2">Both addresses must be within the area covered by your chosen run. We will check them before confirming.</p></div>
<div id="dedicated-fields" class="pilot-fields"><div><label asp-for="Input.PreferredDate">Preferred date</label><input asp-for="Input.PreferredDate" type="date" min="@TippSendApp.Services.PilotService.IrishNow.ToString("yyyy-MM-dd")" class="form-control"><span asp-validation-for="Input.PreferredDate" class="text-danger"></span><p class="pilot-note">Saturday and Sunday requests only.</p></div><div><label asp-for="Input.PreferredTime">Preferred time</label><input asp-for="Input.PreferredTime" class="form-control"><span asp-validation-for="Input.PreferredTime" class="text-danger"></span></div></div></fieldset>
<fieldset><legend>2. Where are we going?</legend><div class="pilot-fields">
<div><label asp-for="Input.PickupAddress">Full pickup address</label><input asp-for="Input.PickupAddress" class="form-control" autocomplete="street-address"><span asp-validation-for="Input.PickupAddress" class="text-danger"></span></div><div><label asp-for="Input.PickupEircode">Pickup Eircode</label><input asp-for="Input.PickupEircode" class="form-control"><span asp-validation-for="Input.PickupEircode" class="text-danger"></span></div>
<div><label asp-for="Input.DropoffAddress">Full delivery address</label><input asp-for="Input.DropoffAddress" class="form-control"><span asp-validation-for="Input.DropoffAddress" class="text-danger"></span></div><div><label asp-for="Input.DropoffEircode">Delivery Eircode</label><input asp-for="Input.DropoffEircode" class="form-control"><span asp-validation-for="Input.DropoffEircode" class="text-danger"></span></div></div></fieldset>
<fieldset><legend>3. Item and contact details</legend><div class="pilot-fields">
<div class="full"><label asp-for="Input.ItemDescription">What are we collecting?</label><textarea asp-for="Input.ItemDescription" class="form-control" rows="2"></textarea><span asp-validation-for="Input.ItemDescription" class="text-danger"></span></div>
<div><label asp-for="Input.WeightKg">Weight (kg, maximum 25)</label><input asp-for="Input.WeightKg" class="form-control" type="number" step="0.1" min="0.1" max="25"><span asp-validation-for="Input.WeightKg" class="text-danger"></span></div><div><label asp-for="Input.DeclaredValue">Item value (€, maximum 500)</label><input asp-for="Input.DeclaredValue" class="form-control" type="number" step="0.01" min="0" max="500"><span asp-validation-for="Input.DeclaredValue" class="text-danger"></span></div>
<div><label asp-for="Input.ContactName">Your name</label><input asp-for="Input.ContactName" class="form-control" autocomplete="name"><span asp-validation-for="Input.ContactName" class="text-danger"></span></div><div><label asp-for="Input.ContactEmail">Your email</label><input asp-for="Input.ContactEmail" class="form-control" autocomplete="email"><span asp-validation-for="Input.ContactEmail" class="text-danger"></span></div>
<div><label asp-for="Input.ContactPhone">Your phone</label><input asp-for="Input.ContactPhone" class="form-control" autocomplete="tel"><span asp-validation-for="Input.ContactPhone" class="text-danger"></span></div><div><label asp-for="Input.RecipientName">Name of the person receiving the item</label><input asp-for="Input.RecipientName" class="form-control"><span asp-validation-for="Input.RecipientName" class="text-danger"></span></div>
<div><label asp-for="Input.RecipientPhone">Their phone number</label><input asp-for="Input.RecipientPhone" class="form-control"><span asp-validation-for="Input.RecipientPhone" class="text-danger"></span></div><div><label asp-for="Input.SpecialInstructions">Access or handling notes (optional)</label><textarea asp-for="Input.SpecialInstructions" class="form-control" rows="2"></textarea><span asp-validation-for="Input.SpecialInstructions" class="text-danger"></span></div></div></fieldset>
<div class="pilot-choice"><input asp-for="Input.Eligible"><label asp-for="Input.Eligible">The item is suitably packaged, fits in a standard car boot and meets the item restrictions below.<small>No cash, hazardous goods, restricted products, medicines or temperature-sensitive items. We check handling requirements before accepting a delivery.</small></label></div><span asp-validation-for="Input.Eligible" class="text-danger"></span>
<p class="pilot-note">Submitting sends an enquiry. Any cancellation, return and handover arrangements will be agreed before a delivery is accepted. Read our <a href="/Privacy">privacy policy</a>.</p>
<button class="pilot-button" type="submit">Send delivery request →</button>
</form>
<aside class="pilot-panel"><div class="pilot-kicker">Before you send a request</div><h2 style="font-size:26px">Everything agreed upfront.</h2><p class="pilot-note">The price shown applies to the selected run and eligible addresses. A separate trip receives its own quote.</p><hr><p class="pilot-note"><strong>No payment on this form.</strong><br>Keep your request reference. To ask about a pending request, email contact@tippsend.ie and include that reference.</p><hr><p class="pilot-note"><strong>Have your item ready.</strong><br>We collect from homes and businesses. Please package the item safely before collection; shopping and gift wrapping are not included.</p>@if(Model.Preview) { <hr><p class="pilot-note"><strong>Local demonstration</strong><br>The listed departures are sample routes for reviewing this page.</p> }</aside></div>
}
</main>
@section Scripts { <script>
const radios=document.querySelectorAll('input[name="Input.Service"]');
function serviceFields(){const scheduled=document.getElementById('scheduled');if(!scheduled)return;document.getElementById('scheduled-fields').hidden=!scheduled.checked;document.getElementById('dedicated-fields').hidden=scheduled.checked;}
radios.forEach(r=>r.addEventListener('change',serviceFields));serviceFields();
const form=document.getElementById('delivery-form');if(form)form.addEventListener('submit',()=>{const b=form.querySelector('button[type="submit"]');b.disabled=true;b.textContent='Sending request…';});
const errors=document.querySelector('.validation-summary-errors');if(errors)errors.focus();
window.addEventListener('pageshow',()=>{if(form){const b=form.querySelector('button[type="submit"]');b.disabled=false;b.textContent='Send delivery request →';}});
</script> }
