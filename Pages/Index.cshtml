@page
@model TippSendApp.Pages.IndexModel
@{ ViewData["Title"]="Local delivery in South Tipperary"; }
<main id="main-content">
<section class="dispatch-hero"><div class="dispatch-shell">
<div class="dispatch-overline"><span>TIPPSEND / LOCAL DELIVERY</span><span>South Tipperary, Ireland</span></div>
<div class="dispatch-heading"><h1>Local delivery.<br>Across South Tipperary.</h1><p>For business orders and everyday items.<br>Choose a scheduled run or request a separate journey, with the price and availability agreed upfront.</p></div>
<div class="dispatch-start dispatch-audiences"><div><a href="/send" class="pilot-button">Send an Item <span aria-hidden="true">↗</span></a><p>Collection and delivery, from your door to theirs.</p></div><div><a href="/partner" class="pilot-button secondary">For Businesses <span aria-hidden="true">↗</span></a><p>Deliver orders to your customers.</p></div></div>
<div class="dispatch-facts"><div><span>DELIVERY DAYS</span><strong>Saturday &amp; Sunday</strong></div><div><span>BUSINESS DELIVERIES</span><strong>Pay per delivery</strong></div><div><span>SEPARATE TRIPS</span><strong>Price agreed upfront</strong></div></div>
</div></section>
<section class="dispatch-service"><div class="dispatch-shell dispatch-service-grid"><div><span class="dispatch-label">CHOOSE A DELIVERY</span><h2>The right journey<br>for your order.</h2><p class="pilot-note">Shared routes suit flexible delivery windows. A separate journey suits a specific time or destination.</p><p class="dispatch-caption">Availability and the full price are agreed before a delivery is confirmed.</p></div><div class="dispatch-services">
<a href="/send?service=Scheduled" class="dispatch-service-row"><div><h3>Scheduled town delivery</h3><p>Packaged items collected and delivered within the same town.</p></div><div><strong>€8 on selected runs</strong><span>Check available times ↗</span></div></a>
<a href="/send?service=Scheduled" class="dispatch-service-row"><div><h3>Scheduled regional delivery</h3><p>Between towns, on a pre-booked shared run.</p></div><div><strong>By route</strong><span>View available times ↗</span></div></a>
<a href="/send?service=Dedicated" class="dispatch-service-row"><div><h3>Separate delivery</h3><p>A separate trip, a rural address or a particular time.</p></div><div><strong>By quote</strong><span>Tell us what you need ↗</span></div></a>
</div></div></section>
<section class="dispatch-availability"><div class="dispatch-shell"><div class="dispatch-section-head"><div><span class="dispatch-label">ROUTES &amp; COVERAGE</span><h2>See what's available.</h2></div><a class="dispatch-text-link" href="/send">Arrange a delivery ↗</a></div>
<div class="dispatch-coverage"><div class="dispatch-departures">
@if(Model.Routes.Count==0){<h3>Routes are being arranged.</h3><p class="pilot-note">Tell us your pickup and destination. We'll check whether a separate trip or an upcoming shared run is available.</p><a class="pilot-button secondary" href="/send">Request a quote →</a>}
else { @foreach(var r in Model.Routes){<a class="dispatch-departure" href="/send?service=Scheduled&amp;route=@r.Id"><div class="dispatch-date"><strong>@r.DepartureDate.ToString("dd")</strong><span>@r.DepartureDate.ToString("MMM").ToUpperInvariant()</span></div><div><h3>@r.Corridor</h3><p>@r.DepartureDate.ToString("dddd") · @r.Window</p></div><div class="dispatch-fare">€@r.Price.ToString("0.##")<span>Request a slot ↗</span></div></a>}}
@if(Model.Preview){<p class="dispatch-caption">Sample departures for this local preview. These are not a published operating timetable.</p>}
</div><aside class="dispatch-area"><span class="dispatch-label">AREAS WE COVER</span><p>Clonmel<br>Cahir<br>Cashel<br>Tipperary Town</p><span class="pilot-note">Other towns and rural addresses considered by route or dedicated quote. Full addresses and Eircodes required.</span></aside></div>
</div></section>
<section class="dispatch-shops"><div class="dispatch-shell"><div class="dispatch-section-head"><div><span class="dispatch-label">FOR INDEPENDENT BUSINESSES</span><h2>A delivery service,<br>without your own driver.</h2></div><a class="pilot-button" href="/partner">Discuss a paid trial ↗</a></div><div class="dispatch-shop-columns"><div><h3>You prepare the order.</h3><p>You keep the sale and package the goods. We agree when and where collection takes place.</p></div><div><h3>We arrange the delivery.</h3><p>A suitable shared run or dedicated trip, with the price, window and handling agreed upfront.</p></div><div><h3>You know it's completed.</h3><p>A record of the handover, with an update if your delivery is delayed.</p></div></div><div class="dispatch-footnote">No compulsory monthly fee during your trial. Regular customers can discuss a monthly minimum credited against delivery charges. Gift sourcing and wrapping are a later service.</div></div></section>
</main>