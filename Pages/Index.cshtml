@page
@model IndexModel
@{
    ViewData["Title"] = "TippSend — Fast, Local, Trusted Delivery in South Tipperary";
}

@section Styles {
<style>
body { background: var(--gs-cream); }

/* ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ */
.hero {
    background: var(--gs-cream);
    overflow: hidden;
    position: relative;
}
.hero-inner {
    display: grid;
    grid-template-columns: 55fr 45fr;
    min-height: 480px;
    align-items: center;
}
.hero-text {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 48px 72px 24px;
}
.hero-badge {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid rgba(31,58,46,0.3);
    border-radius: var(--r-pill);
    padding: 6px 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gs-bog-deep);
    margin-bottom: 24px;
}
.hero-h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(36px, 4.8vw, 64px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--gs-bog-deep);
    margin: 0 0 20px;
}
.hero-sub {
    font-size: 16px;
    color: var(--gs-stone);
    line-height: 1.65;
    margin: 0 auto 32px;
    max-width: 400px;
}

/* Van photo — right column */
.hero-photo {
    position: relative;
    align-self: stretch;
    overflow: hidden;
}
.hero-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 100px;
    background: linear-gradient(to right, var(--gs-cream), transparent);
    z-index: 1;
    pointer-events: none;
}
.hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    min-height: 480px;
}

@@media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; min-height: auto; }
    .hero-text { padding: 60px 24px 40px; }
    .hero-photo { height: 260px; }
    .hero-photo img { min-height: 260px; }
    .hero-photo::before { display: none; }
}
@@media (max-width: 480px) {
    .hero-text { padding: 40px 16px 32px; text-align: center; }
    .hero-photo { height: 200px; }
    .hero-photo img { min-height: 200px; }
    .hero-badge { font-size: 10px; padding: 5px 14px; }
}

/* ══════════════════════════════════════════
   SERVICE CARDS
══════════════════════════════════════════ */
.svc-section {
    background: var(--gs-cream);
    padding: 0 0 72px;
}
.svc-deck {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}
@@media (max-width: 900px) { .svc-deck { grid-template-columns: 1fr; } }

.svc-card {
    background: var(--gs-paper);
    border: 1.5px solid var(--gs-mist);
    border-radius: var(--r-lg);
    padding: 36px 28px 28px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s var(--ease-spring), box-shadow 0.2s;
}
.svc-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-2);
    color: inherit;
}
.svc-card__icon {
    width: 72px;
    height: 72px;
    margin-bottom: 18px;
}
.svc-card__name {
    font-size: 20px;
    font-weight: 700;
    color: var(--gs-bog-deep);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
}
.svc-card__desc {
    font-size: 13px;
    line-height: 1.65;
    color: var(--gs-stone);
    margin: 0 0 22px;
    flex: 1;
}
.svc-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    border: 1.5px solid var(--gs-bog-deep);
    border-radius: var(--r-pill);
    padding: 9px 22px;
    color: var(--gs-bog-deep);
    transition: background 0.15s, color 0.15s;
}
.svc-card:hover .svc-card__cta {
    background: var(--gs-bog-deep);
    color: var(--gs-cream);
}

/* ══════════════════════════════════════════
   STATS BAR
══════════════════════════════════════════ */
.stats-bar {
    background: var(--gs-bog-deep);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}
@@media (max-width: 640px) { .stats-bar { grid-template-columns: 1fr 1fr; } }
.stat-cell {
    padding: 28px 24px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    border-right: 1px solid rgba(255,255,255,0.07);
}
.stat-cell:last-child { border-right: none; }
.stat-cell__icon { font-size: 22px; flex-shrink: 0; margin-top: 2px; }
.stat-cell__val { font-size: 13px; font-weight: 600; color: white; margin-bottom: 4px; }
.stat-cell__lbl { font-size: 11px; color: var(--gs-fog); line-height: 1.5; margin: 0; }
</style>
}

<!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
<section class="hero">
    <div class="hero-inner">
        <!-- Text block — centered -->
        <div class="hero-text" data-anim>
            <div class="hero-badge">South Tipperary · Est. 2026</div>
            <h1 class="hero-h1">
                Fast, Local, Trusted Delivery<br>
                <em style="font-style:italic">in South Tipperary.</em>
            </h1>
            <p class="hero-sub">
                Three simple services. One local team. Delivering convenience across South Tipperary.
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a href="/gift" class="btn btn-gold" style="font-size:15px;padding:13px 30px">Send a Gift →</a>
                <a href="/send" class="btn" style="font-size:15px;padding:13px 30px;border:2px solid var(--gs-bog-deep);color:var(--gs-bog-deep);background:transparent">Book a Pickup →</a>
            </div>
        </div>

        <!-- Van photo — right side, bleeds to edge -->
        <div class="hero-photo" aria-hidden="true">
            <img src="/images/van-countryside.jpg" alt="TippSend van on South Tipperary countryside">
        </div>
    </div>

    <!-- ── Service Cards ── -->
    <section class="svc-section">
        <div class="container-xl">
            <div class="svc-deck" data-anim style="--anim-delay:0.1s">

                <!-- Gift & Deliver -->
                <a href="/gift" class="svc-card">
                    <svg class="svc-card__icon" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="9" y="32" width="54" height="32" rx="3" stroke="#1F3A2E" stroke-width="2.5"/>
                        <rect x="13" y="22" width="46" height="12" rx="2" stroke="#1F3A2E" stroke-width="2.5"/>
                        <line x1="36" y1="22" x2="36" y2="64" stroke="#1F3A2E" stroke-width="2.5"/>
                        <path d="M36 22C36 22 27 22 24 17C21 12 25 7 30 9.5C33 11 36 15 36 22Z" stroke="#C9A24B" stroke-width="2.2" fill="none" stroke-linecap="round"/>
                        <path d="M36 22C36 22 45 22 48 17C51 12 47 7 42 9.5C39 11 36 15 36 22Z" stroke="#C9A24B" stroke-width="2.2" fill="none" stroke-linecap="round"/>
                    </svg>
                    <div class="svc-card__name">Gift &amp; Deliver</div>
                    <p class="svc-card__desc">Send something special from a real local Tipperary shop — flowers, cake, whiskey — at exactly the moment you choose. Handwritten card included.</p>
                    <span class="svc-card__cta">Send a gift →</span>
                </a>

                <!-- Pickup & Drop -->
                <a href="/send" class="svc-card">
                    <svg class="svc-card__icon" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="8" y="28" width="40" height="26" rx="3" stroke="#1F3A2E" stroke-width="2.5"/>
                        <path d="M48 36h8l5 10v8H48V36z" stroke="#1F3A2E" stroke-width="2.5" stroke-linejoin="round"/>
                        <circle cx="20" cy="57" r="5.5" stroke="#1F3A2E" stroke-width="2.5"/>
                        <circle cx="54" cy="57" r="5.5" stroke="#1F3A2E" stroke-width="2.5"/>
                        <circle cx="50" cy="16" r="7" stroke="#C9A24B" stroke-width="2.2"/>
                        <line x1="50" y1="9" x2="50" y2="6" stroke="#C9A24B" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M44 26 Q50 32 50 23" stroke="#C9A24B" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    </svg>
                    <div class="svc-card__name">Pickup &amp; Drop</div>
                    <p class="svc-card__desc">Need something collected and delivered? See your flat-rate price instantly and pay online — no waiting for quotes.</p>
                    <span class="svc-card__cta">Book a pickup →</span>
                </a>

                <!-- Partner With Us -->
                <a href="/partner" class="svc-card">
                    <svg class="svc-card__icon" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="10" y="30" width="52" height="32" rx="3" stroke="#1F3A2E" stroke-width="2.5"/>
                        <path d="M22 30V24a14 14 0 0 1 28 0v6" stroke="#1F3A2E" stroke-width="2.5" stroke-linecap="round"/>
                        <rect x="28" y="42" width="16" height="14" rx="2" stroke="#1F3A2E" stroke-width="2.5"/>
                        <circle cx="55" cy="20" r="9" fill="var(--gs-cream)" stroke="#C9A24B" stroke-width="2.2"/>
                        <line x1="55" y1="15" x2="55" y2="25" stroke="#C9A24B" stroke-width="2" stroke-linecap="round"/>
                        <line x1="50" y1="20" x2="60" y2="20" stroke="#C9A24B" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <div class="svc-card__name">Partner With Us</div>
                    <p class="svc-card__desc">Local shop needing a delivery service? Get a shared delivery driver on a simple monthly retainer. No van, no insurance, no faff.</p>
                    <span class="svc-card__cta">Get in touch →</span>
                </a>

            </div>
        </div>
    </section>
</section>

<!-- ═══ STATS BAR ════════════════════════════════════════════════ -->
<div class="stats-bar" data-anim style="--anim-delay:0.1s">
    <div class="stat-cell">
        <div class="stat-cell__icon">📷</div>
        <div>
            <div class="stat-cell__val">Photo on delivery</div>
            <p class="stat-cell__lbl">Every order, every time. Sent to sender via WhatsApp.</p>
        </div>
    </div>
    <div class="stat-cell">
        <div class="stat-cell__icon">⏱</div>
        <div>
            <div class="stat-cell__val">Window guarantee</div>
            <p class="stat-cell__lbl">Miss the window? You get a refund. Simple.</p>
        </div>
    </div>
    <div class="stat-cell">
        <div class="stat-cell__icon">📦</div>
        <div>
            <div class="stat-cell__val">Zero inventory</div>
            <p class="stat-cell__lbl">Purchased fresh from the shop the morning of delivery.</p>
        </div>
    </div>
    <div class="stat-cell">
        <div class="stat-cell__icon">🇮🇪</div>
        <div>
            <div class="stat-cell__val">Local to the core</div>
            <p class="stat-cell__lbl">South Tipperary. Real shops, real neighbours.</p>
        </div>
    </div>
</div>
