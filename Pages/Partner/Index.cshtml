@page "/partner"
@model TippSendApp.Pages.Partner.IndexModel
@{ ViewData["Title"]="Delivery for local businesses"; }
<main id="main-content"><section class="pilot-hero"><div class="pilot-wrap pilot-grid"><div><div class="pilot-kicker">For local businesses</div><h1>Keep serving.<br>We'll do the driving.</h1><p class="pilot-lead">Prepared-order delivery for South Tipperary shops and local businesses. Scheduled runs and dedicated trips, with a price and window agreed before acceptance.</p><p class="pilot-note">Paid trial · Pay per delivery · No mandatory retainer</p><div class="pilot-actions"><a href="#shop-enquiry" class="pilot-button">Start a business enquiry →</a><a href="/send" class="pilot-button secondary">Request a delivery</a></div></div><div class="pilot-panel"><div class="pilot-kicker">Start small. Make it repeatable.</div><h2>Delivery on your terms.</h2><p class="pilot-note">Tell us where your orders are collected, where they need to go and when they are ready. We'll look for a suitable delivery option.</p><hr><p class="pilot-note"><strong>You keep the sale.</strong><br>You charge for the goods. We agree with you who pays for delivery.</p><hr><p class="pilot-note"><strong>Weekend and overflow cover.</strong><br>Availability is confirmed for each run or dedicated trip.</p></div></div></section>
<section class="pilot-section pilot-band"><div class="pilot-wrap"><h2>A simple start, without a subscription.</h2><div class="pilot-three"><div><span class="pilot-number">START HERE</span><h3>Paid trial</h3><p>Pay per delivery at the agreed price. Test the handover process and delivery windows before making a longer commitment.</p></div><div><span class="pilot-number">AFTER REPEAT DEMAND</span><h3>Usable delivery credit</h3><p>For regular customers, an optional monthly minimum counts towards delivery charges. For example, with a €120 minimum, you pay €120 if your eligible deliveries total €80, or €180 if they total €180. Any unused credit and rollover rules are agreed in advance.</p></div><div><span class="pilot-number">WHEN YOU NEED MORE</span><h3>Reserved capacity</h3><p>Discuss an agreed block of driver time, with hours, area and workload defined. Shared capacity is not an exclusive driver.</p></div></div></div></section>
<section class="pilot-section" id="shop-enquiry"><div class="pilot-wrap pilot-grid" style="align-items:start"><div><div class="pilot-kicker">Let's find the right fit</div><h2>Tell us about your business.</h2><p class="pilot-lead">Tell us how often you need delivery, where your customers are and when orders are ready to collect.</p><p class="pilot-note">Clonmel · Cahir · Cashel · Tipperary Town<br>Other addresses considered by route or dedicated quote.</p></div><div class="pilot-panel">
@if(Model.Submitted) { <div class="pilot-success" role="status"><h3>Thank you for your enquiry.</h3><p>Thank you. We'll review your delivery needs and contact you using the details provided. Submitting this form does not commit you to a delivery or monthly plan.</p></div> }
else { <form method="post" class="pilot-form"><div asp-validation-summary="All" role="alert" tabindex="-1" id="form-errors"></div><p class="pilot-note">All fields are required.</p><div class="pilot-fields"><div class="full"><label asp-for="BusinessName">Business name</label><input asp-for="BusinessName" class="form-control" autocomplete="organization"><span asp-validation-for="BusinessName" class="text-danger"></span></div><div><label asp-for="ShopType">Business type</label><select asp-for="ShopType" class="form-select"><option value="">Choose a type</option><option>Florist or gift shop</option><option>Bakery or maker</option><option>Independent retailer</option><option>Other</option></select><span asp-validation-for="ShopType" class="text-danger"></span></div><div><label asp-for="WeeklyDeliveries">Typical weekly deliveries</label><select asp-for="WeeklyDeliveries" class="form-select"><option value="">Choose a range</option><option>1–5</option><option>6–15</option><option>16–30</option><option>30+</option></select><span asp-validation-for="WeeklyDeliveries" class="text-danger"></span></div><div><label asp-for="ContactName">Contact name</label><input asp-for="ContactName" class="form-control" autocomplete="name"><span asp-validation-for="ContactName" class="text-danger"></span></div><div><label asp-for="Phone">Phone</label><input asp-for="Phone" class="form-control" autocomplete="tel"><span asp-validation-for="Phone" class="text-danger"></span></div><div class="full"><label asp-for="Email">Email</label><input asp-for="Email" class="form-control" autocomplete="email"><span asp-validation-for="Email" class="text-danger"></span></div><div class="full"><label asp-for="DeliveryNeeds">Pickup town, destinations and ready times</label><textarea asp-for="DeliveryNeeds" class="form-control" rows="3"></textarea><span asp-validation-for="DeliveryNeeds" class="text-danger"></span></div></div><p class="pilot-note mt-3">We'll use these details to review your enquiry. <a href="/Privacy">Privacy policy</a>.</p><button class="pilot-button" type="submit">Send business enquiry →</button></form> }
</div></div></section></main>

@section Scripts { <script>const errors=document.querySelector(".validation-summary-errors");if(errors)errors.focus();</script> }
